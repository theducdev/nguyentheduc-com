---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyButton from '../../components/BuyButton.astro';
import SaleCountdown from '../../components/SaleCountdown.astro';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => !data.draft);
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const d = product.data;

const STATUS_LABEL: Record<string, { label: string; color: string }> = {
  live: { label: 'Live', color: '#16a34a' },
  beta: { label: 'Beta', color: '#d97706' },
  wip: { label: 'Đang phát triển', color: '#0284c7' },
  paused: { label: 'Tạm dừng', color: '#6b7280' },
};
const status = STATUS_LABEL[d.status];

const saleActive =
  !!d.salePriceAmount && (!d.saleHardDeadline || d.saleHardDeadline.getTime() > Date.now());
---

<BaseLayout
  title={`${d.title} | Sản phẩm | Nguyễn Thế Đức`}
  description={d.description}
  ogImage={d.thumbnail}
  ogImageAlt={d.title}
  ogImageWidth={1024}
  ogImageHeight={1024}
  ogType="product"
>
  <article class="prose">
    <img src={d.thumbnail} alt={d.title}
         style="width: 100%; max-height: 360px; object-fit: cover; border-radius: 12px; margin-bottom: 1.5rem; background: var(--muted);" />

    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
      <h1 style="margin: 0;">{d.title}</h1>
      <span class="product-status" style={`--status-color:${status.color}`}>
        <span class="dot" /> {status.label}
      </span>
    </div>
    <p style="font-size: 1.1rem; opacity: 0.85; margin-top: 0.25rem;">{d.description}</p>

    {saleActive && (
      <SaleCountdown hardDeadline={d.saleHardDeadline} size="lg" />
    )}

    {
      (d.price || d.priceAmount) && (
        <div class="buy-card price-block" data-sale-hard-deadline={d.saleHardDeadline?.toISOString() ?? ''}>
          <div class="buy-price-block">
            {saleActive && d.salePrice ? (
              <>
                <span class="sale-only buy-sale-price">{d.salePrice}</span>
                <span class="sale-only buy-old-price">{d.price}</span>
              </>
            ) : (
              <>
                {d.price && <span class="buy-price">{d.price}</span>}
                {d.priceNote && <span class="buy-price-note">{d.priceNote}</span>}
              </>
            )}
          </div>
          {d.priceAmount ? (
            <BuyButton
              productSlug={product.slug}
              productTitle={d.title}
              amount={d.priceAmount}
              saleAmount={d.salePriceAmount}
              saleHardDeadline={d.saleHardDeadline}
              transferContent={d.transferContent}
              label={d.buyLabel}
              buttonClass="btn-buy-large"
            />
          ) : d.buyLink ? (
            <a href={d.buyLink} target={d.buyLink.startsWith('http') ? '_blank' : undefined}
               rel={d.buyLink.startsWith('http') ? 'noopener noreferrer' : undefined}
               class="btn-buy-large">
              {d.buyLabel}
            </a>
          ) : null}
        </div>
      )
    }

    <hr style="margin: 2rem 0;" />
    <Content />

    {
      d.priceAmount && (
        <div style="text-align: center; margin: 3rem 0 1rem 0;">
          <BuyButton
            productSlug={`${product.slug}-bottom`}
            productTitle={d.title}
            amount={d.priceAmount}
            saleAmount={d.salePriceAmount}
            saleHardDeadline={d.saleHardDeadline}
            transferContent={d.transferContent}
            label={d.buyLabel}
            buttonClass="btn-buy-large"
          />
        </div>
      )
    }
  </article>

  <div class="all-posts-link" style="margin-top: 2rem;">
    <a href="/products">← Quay lại danh sách sản phẩm</a>
  </div>
</BaseLayout>
