---
import { PAYMENT, SITE } from '../config';

interface Props {
  productSlug: string;
  productTitle: string;
  amount: number;                       // giá gốc
  saleAmount?: number;                  // giá sale (nếu có)
  saleEndsAt?: Date;
  transferContent?: string;
  label?: string;
  buttonClass?: string;
}

const {
  productSlug,
  productTitle,
  amount,
  saleAmount,
  saleEndsAt,
  transferContent = `MUA ${productSlug.replace(/-/g, '').toUpperCase()}`,
  label = 'Mua ngay',
  buttonClass = 'btn-buy-large',
} = Astro.props;

const buildQR = (amt: number) =>
  `${PAYMENT.qrApi}?acc=${PAYMENT.account}&bank=${PAYMENT.bank}&amount=${amt}&des=${encodeURIComponent(transferContent)}`;

const isSaleActive = !!(saleAmount && saleEndsAt && saleEndsAt.getTime() > Date.now());
const currentAmount = isSaleActive ? saleAmount! : amount;
const currentQR = buildQR(currentAmount);
const regularQR = buildQR(amount);
const saleQR = saleAmount ? buildQR(saleAmount) : '';

const dialogId = `buy-${productSlug}`;
---

<button class={buttonClass} data-buy-open={dialogId} type="button">
  {label}
</button>

<dialog id={dialogId} class="buy-modal" aria-label={`Mua ${productTitle}`}
  data-sale-ends={saleEndsAt?.toISOString()}
  data-regular-amount={amount}
  data-sale-amount={saleAmount}
  data-regular-qr={regularQR}
  data-sale-qr={saleQR}
  data-transfer-content={transferContent}>
  <button class="buy-modal-close" data-buy-close aria-label="Đóng">×</button>

  <div class="buy-modal-content">
    <h2 class="buy-modal-title">{productTitle}</h2>
    <p class="buy-modal-sub">Quét QR bằng app ngân hàng để chuyển khoản tự động:</p>

    <img src={currentQR} alt={`QR thanh toán ${productTitle}`} class="buy-modal-qr"
         data-qr-img width="280" height="280" loading="lazy" />

    <div class="buy-modal-info">
      <div class="buy-info-row"><span>Ngân hàng</span><strong>{PAYMENT.bank}</strong></div>
      <div class="buy-info-row"><span>Số tài khoản</span><strong>{PAYMENT.account}</strong></div>
      <div class="buy-info-row"><span>Chủ tài khoản</span><strong>{PAYMENT.accountName}</strong></div>
      <div class="buy-info-row">
        <span>Số tiền</span>
        <strong class="amount" data-qr-amount>{currentAmount.toLocaleString('vi-VN')}đ</strong>
      </div>
      <div class="buy-info-row"><span>Nội dung CK</span><strong>{transferContent}</strong></div>
    </div>

    <p class="buy-modal-after">
      Sau khi chuyển khoản, inbox
      <a href="https://www.facebook.com/duckhoinghiep" target="_blank" rel="noopener noreferrer">Facebook</a>
      hoặc Zalo <a href={`tel:${SITE.phone}`}>{SITE.phone}</a>
      kèm ảnh chuyển khoản để nhận sản phẩm.
    </p>
  </div>
</dialog>
