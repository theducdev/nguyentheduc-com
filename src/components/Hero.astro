---
import { SITE } from '../config';
import Socials from './Socials.astro';
---

<section class="hero">
  <div class="hero-inner">
    <a href="/about" aria-label="Giới thiệu">
      <img src="/avatar.jpg" alt={SITE.author} class="hero-avatar" width="160" height="160" />
    </a>
    <div class="hero-text">
      <div class="hero-heading">
        <h1>Chào, mình là Đức 👋</h1>
        <a href="/rss.xml" class="rss-link" aria-label="RSS Feed" title="RSS Feed">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
            <path d="M4 4a16 16 0 0 1 16 16" />
            <path d="M4 11a9 9 0 0 1 9 9" />
          </svg>
        </a>
      </div>
      <p class="hero-desc">
        <strong>CEO / Co-Founder TECHLA AI</strong> — xây các công cụ AI và tự động hoá cho doanh nghiệp Việt.<br />
        Đồng sáng lập 2 cộng đồng <em>TECHLA AI – DEV OUTSOURCE</em> và <em>Tedux AI Automation</em>.
      </p>
      <Socials />
    </div>
  </div>
</section>

<div class="container">
  <hr aria-hidden="true" />
</div>
