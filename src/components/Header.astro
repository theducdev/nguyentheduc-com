---
import { SITE } from '../config';
const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="nav-wrap">
    <a href="/" class="site-title">{SITE.title}</a>

    <nav class="main-nav" aria-label="Main navigation">
      <a href="/posts" class:list={{ active: pathname.startsWith('/posts') }}>Bài viết</a>
      <a href="/about" class:list={{ active: pathname.startsWith('/about') }}>Giới thiệu</a>

      <a href="/rss.xml" class="icon-btn" aria-label="RSS Feed" title="RSS Feed">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <path d="M4 11a9 9 0 0 1 9 9" />
        </svg>
      </a>
    </nav>
  </div>

  <div class="container">
    <hr aria-hidden="true" />
  </div>
</header>
