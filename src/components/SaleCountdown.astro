---
interface Props {
  hardDeadline?: Date;
  slotHours?: number;
  size?: 'sm' | 'md' | 'lg';
}

const { hardDeadline, slotHours = 6, size = 'md' } = Astro.props;
---

<div
  class={`sale-countdown sale-countdown-${size}`}
  data-sale-rolling={String(slotHours)}
  data-sale-hard-deadline={hardDeadline?.toISOString() ?? ''}
>
  <span class="sale-badge">🔥 SALE</span>
  <span class="sale-deadline" data-sale-deadline-text>—</span>
  <span class="sale-remaining" aria-live="polite" data-sale-remaining>—</span>
</div>
