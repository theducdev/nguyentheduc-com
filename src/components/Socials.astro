---
import { SOCIALS } from '../config';

const ICONS: Record<string, string> = {
  Facebook: `<path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" />`,
  FacebookPage: `<rect x="3" y="3" width="18" height="18" rx="3" ry="3" />
                 <path d="M13 8h2a1 1 0 0 1 1 1v2h-3v2h3v6h-3v-6h-2v-2h2v-2a3 3 0 0 1 3 -3" />`,
  TikTok: `<path d="M21 7.917v4.034a9.948 9.948 0 0 1 -5 -1.951v4.5a6.5 6.5 0 1 1 -8 -6.326v4.326a2.5 2.5 0 1 0 4 2v-11.5h4.083a6.005 6.005 0 0 0 4.917 4.917z" />`,
  Zalo: `<path d="M12 21c-1.4 0 -2.7 -.3 -3.9 -.8l-3.1 1.3l1.1 -2.9c-1.3 -1.5 -2.1 -3.4 -2.1 -5.6c0 -4.4 4 -8 9 -8s9 3.6 9 8s-4 8 -9 8" />
         <path d="M8 11.5l3.5 0" />
         <path d="M15.5 11.5l0 3" />
         <path d="M13.5 11.5l4 0" />`,
  Phone: `<path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />`,
  Mail: `<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
         <path d="M3 7l9 6l9 -6" />`,
  Github: `<path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />`,
};
---

<div class="socials">
  {
    SOCIALS.filter((s) => s.active).map((s) => (
      <a href={s.href} title={s.linkTitle} aria-label={s.linkTitle}
         target={s.href.startsWith('http') ? '_blank' : undefined}
         rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.name] ?? ''} />
        <span class="sr-only">{s.linkTitle}</span>
      </a>
    ))
  }
</div>
