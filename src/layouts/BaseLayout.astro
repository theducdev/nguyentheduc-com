---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article' | 'product';
}

const {
  title = SITE.title,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  ogImageAlt = SITE.title,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();

// Guess image type from extension (Facebook/Zalo prefer explicit type)
const ext = ogImage.split('.').pop()?.toLowerCase() || 'jpg';
const mimeType =
  ext === 'png' ? 'image/png' :
  ext === 'webp' ? 'image/webp' :
  ext === 'svg' ? 'image/svg+xml' :
  'image/jpeg';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content={mimeType} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="nguyentheduc.com" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta property="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
  </head>
  <body>
    <Header />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />

    <script>
      // ===== Buy dialog open/close =====
      function bindDialogs() {
        document.querySelectorAll('[data-buy-open]').forEach((btn) => {
          if ((btn as HTMLElement).dataset.bound) return;
          (btn as HTMLElement).dataset.bound = '1';
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-buy-open');
            const dialog = id ? document.getElementById(id) : null;
            if (dialog instanceof HTMLDialogElement) dialog.showModal();
          });
        });
        document.querySelectorAll('[data-buy-close]').forEach((btn) => {
          if ((btn as HTMLElement).dataset.bound) return;
          (btn as HTMLElement).dataset.bound = '1';
          btn.addEventListener('click', () => {
            const d = btn.closest('dialog');
            if (d instanceof HTMLDialogElement) d.close();
          });
        });
        document.querySelectorAll('dialog.buy-modal').forEach((d) => {
          if ((d as HTMLElement).dataset.bound) return;
          (d as HTMLElement).dataset.bound = '1';
          d.addEventListener('click', (e) => {
            if (e.target === d && d instanceof HTMLDialogElement) d.close();
          });
        });
      }

      // ===== Rolling countdown + hard-deadline revert =====
      const TZ_OFFSET_MIN = 7 * 60; // Asia/Ho_Chi_Minh (UTC+7)
      const pad = (n: number) => String(n).padStart(2, '0');

      // Tính mốc kết thúc slot tiếp theo (vd slot 6h → 0:00, 6:00, 12:00, 18:00 giờ VN)
      function nextSaleSlot(slotHours: number): number {
        const now = Date.now();
        const tzNow = now + TZ_OFFSET_MIN * 60_000;
        const slotMs = slotHours * 3_600_000;
        const elapsed = ((tzNow % slotMs) + slotMs) % slotMs;
        const remain = elapsed === 0 ? slotMs : slotMs - elapsed;
        return now + remain;
      }

      function fmtDeadline(endsAt: number): string {
        const now = Date.now();
        const tzNow = new Date(now + TZ_OFFSET_MIN * 60_000);
        const tzEnd = new Date(endsAt + TZ_OFFSET_MIN * 60_000);
        const sameDay =
          tzNow.getUTCFullYear() === tzEnd.getUTCFullYear() &&
          tzNow.getUTCMonth() === tzEnd.getUTCMonth() &&
          tzNow.getUTCDate() === tzEnd.getUTCDate();
        // 00:00 ngày mai hiển thị là "00:00 ngày mai" cho dễ hiểu
        const hh = pad(tzEnd.getUTCHours());
        const mm = pad(tzEnd.getUTCMinutes());
        return `Hết sale lúc ${hh}:${mm} ${sameDay ? 'hôm nay' : 'ngày mai'}`;
      }

      function fmtRemaining(ms: number): string {
        const s = Math.max(0, Math.floor(ms / 1000));
        const h = Math.floor(s / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = s % 60;
        if (h > 0) return `còn ${h}h ${pad(m)}p ${pad(sec)}s`;
        if (m > 0) return `còn ${m}p ${pad(sec)}s`;
        return `còn ${sec}s`;
      }

      function isHardDeadlinePassed(iso: string | undefined): boolean {
        if (!iso) return false;
        const t = new Date(iso).getTime();
        return Number.isFinite(t) && t <= Date.now();
      }

      function tickCountdowns() {
        // Update rolling countdown text
        document.querySelectorAll<HTMLElement>('.sale-countdown[data-sale-rolling]').forEach((el) => {
          const slot = parseInt(el.dataset.saleRolling || '6', 10) || 6;
          const hardDeadline = el.dataset.saleHardDeadline;
          if (isHardDeadlinePassed(hardDeadline)) {
            el.classList.add('expired');
            return;
          }
          const ends = nextSaleSlot(slot);
          const remain = ends - Date.now();
          const deadlineEl = el.querySelector<HTMLElement>('[data-sale-deadline-text]');
          const remainEl = el.querySelector<HTMLElement>('[data-sale-remaining]');
          if (deadlineEl) deadlineEl.textContent = fmtDeadline(ends);
          if (remainEl) remainEl.textContent = fmtRemaining(remain);
        });

        // Revert sale UI / QR if hard deadline passed (idempotent)
        document.querySelectorAll<HTMLElement>('[data-sale-hard-deadline]').forEach((el) => {
          if (!isHardDeadlinePassed(el.dataset.saleHardDeadline)) return;
          el.classList.add('sale-expired');
          // Swap QR + amount in BuyButton dialogs
          if (el.tagName === 'DIALOG') {
            const regularQR = el.dataset.regularQr;
            const regularAmount = el.dataset.regularAmount;
            const img = el.querySelector<HTMLImageElement>('[data-qr-img]');
            const amt = el.querySelector<HTMLElement>('[data-qr-amount]');
            if (img && regularQR) img.src = regularQR;
            if (amt && regularAmount) {
              amt.textContent = parseInt(regularAmount, 10).toLocaleString('vi-VN') + 'đ';
            }
          }
        });
      }

      function init() {
        bindDialogs();
        tickCountdowns();
      }

      init();
      setInterval(tickCountdowns, 1000);
      document.addEventListener('astro:after-swap', init);
    </script>
  </body>
</html>
