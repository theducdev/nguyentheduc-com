---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = SITE.title,
  description = SITE.desc,
  ogImage = SITE.ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
  </head>
  <body>
    <Header />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />

    <script>
      // ===== Buy dialog open/close =====
      function bindDialogs() {
        document.querySelectorAll('[data-buy-open]').forEach((btn) => {
          if ((btn as HTMLElement).dataset.bound) return;
          (btn as HTMLElement).dataset.bound = '1';
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-buy-open');
            const dialog = id ? document.getElementById(id) : null;
            if (dialog instanceof HTMLDialogElement) dialog.showModal();
          });
        });
        document.querySelectorAll('[data-buy-close]').forEach((btn) => {
          if ((btn as HTMLElement).dataset.bound) return;
          (btn as HTMLElement).dataset.bound = '1';
          btn.addEventListener('click', () => {
            const d = btn.closest('dialog');
            if (d instanceof HTMLDialogElement) d.close();
          });
        });
        document.querySelectorAll('dialog.buy-modal').forEach((d) => {
          if ((d as HTMLElement).dataset.bound) return;
          (d as HTMLElement).dataset.bound = '1';
          d.addEventListener('click', (e) => {
            if (e.target === d && d instanceof HTMLDialogElement) d.close();
          });
        });
      }

      // ===== Countdown + sale revert =====
      const pad = (n: number) => String(n).padStart(2, '0');

      function tickCountdowns() {
        const now = Date.now();
        let anyExpired = false;
        document.querySelectorAll<HTMLElement>('.sale-countdown[data-sale-ends]').forEach((el) => {
          const ends = new Date(el.dataset.saleEnds || '').getTime();
          const diff = ends - now;
          if (diff <= 0) {
            el.classList.add('expired');
            el.style.display = 'none';
            anyExpired = true;
            return;
          }
          const d = Math.floor(diff / 86400000);
          const h = Math.floor((diff % 86400000) / 3600000);
          const m = Math.floor((diff % 3600000) / 60000);
          const s = Math.floor((diff % 60000) / 1000);
          const dEl = el.querySelector('[data-d]');
          const hEl = el.querySelector('[data-h]');
          const mEl = el.querySelector('[data-m]');
          const sEl = el.querySelector('[data-s]');
          if (dEl) dEl.textContent = String(d);
          if (hEl) hEl.textContent = pad(h);
          if (mEl) mEl.textContent = pad(m);
          if (sEl) sEl.textContent = pad(s);
        });

        // Revert sale UI / QR if expired (idempotent)
        document.querySelectorAll<HTMLElement>('[data-sale-ends]').forEach((el) => {
          const ends = new Date(el.dataset.saleEnds || '').getTime();
          if (ends - now > 0) return;
          // Mark expired
          el.classList.add('sale-expired');
          // Swap QR + amount in BuyButton dialogs
          if (el.tagName === 'DIALOG') {
            const regularQR = el.dataset.regularQr;
            const regularAmount = el.dataset.regularAmount;
            const img = el.querySelector<HTMLImageElement>('[data-qr-img]');
            const amt = el.querySelector<HTMLElement>('[data-qr-amount]');
            if (img && regularQR) img.src = regularQR;
            if (amt && regularAmount) {
              amt.textContent = parseInt(regularAmount, 10).toLocaleString('vi-VN') + 'đ';
            }
          }
        });

        // Toggle sale-price / regular-price displays anywhere
        document.querySelectorAll<HTMLElement>('.price-block[data-sale-ends]').forEach((el) => {
          const ends = new Date(el.dataset.saleEnds || '').getTime();
          if (ends - now <= 0) el.classList.add('sale-expired');
        });
      }

      function init() {
        bindDialogs();
        tickCountdowns();
      }

      init();
      setInterval(tickCountdowns, 1000);
      document.addEventListener('astro:after-swap', init);
    </script>
  </body>
</html>
